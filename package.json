{
  "name": "spruce-gmail-service",
  "version": "0.5.38",
  "installLevel": 5,
  "private": true,
  "description": "S.P.R.U.C.E+ for a whole Google Workspace domain: checks every new email with the extension's own checks and AI model, and moves suspicious ones to Spam (or only records them, in monitor mode), with an admin dashboard.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "demo": "DEMO=1 PORT=8080 node src/server.js",
    "pretest": "node tools/fetch-model.js --quiet",
    "test": "node --test test/*.test.js",
    "predemo": "node tools/fetch-model.js --quiet"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.0",
    "fflate": "^0.8.3",
    "google-auth-library": "^11.3.3",
    "htmlparser2": "^12.0.0",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "mailparser": "^3.14.2",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "^6.5.438",
    "pngjs": "^7.0.0"
  },
  "overrides": {
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4"
  }
}
