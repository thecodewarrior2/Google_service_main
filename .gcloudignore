# What Cloud Build uploads when deploy/install.sh builds without Docker.
node_modules/
build/
test/
# (tools/* and not tools/: a file inside an ignored folder can't be let back in)
tools/*
# …except the one that downloads the AI model into the image (Dockerfile).
!tools/fetch-model.js
docs/
deploy/
.git/
*.md
.env
*.key.json
service-account*.json
