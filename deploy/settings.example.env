# S.P.R.U.C.E Mail Protection Service: install settings (docs/INSTALL.md).
# Copy this file to deploy/settings.env, fill it in, then run: bash deploy/install.sh
# Lists take semicolons. Never put keys or passwords in this file: the service has none.

# Your Google Cloud project (a new one, made for this service) and its region. us-central1 (Iowa) or
# us-west1 (Oregon): among the cheapest for Firestore; us-east1 (South Carolina) costs twice as much, the
# only US region that does. Cloud Run costs the same. The region can't be changed once installed
# (Firestore stays where it was made).
PROJECT=my-spruce-project
REGION=us-central1

# Your organization's own email domains.
ORG_DOMAINS=maple-schools.example

# The security group whose members' mailboxes are watched. Only these mailboxes are read.
PILOT_GROUP=spruce-pilot@maple-schools.example

# The dedicated admin account the service acts as to read that group's members
# (an admin role with only Groups > Read; docs/INSTALL.md, step 2).
DIRECTORY_ADMIN=spruce-directory@maple-schools.example

# Who may open the dashboard: the members of a group (groups inside it count), and/or a list of
# addresses. Set at least one. Identity-Aware Proxy lets them in, and the service checks again.
ADMIN_GROUP=spruce-admins@maple-schools.example
ADMIN_EMAILS=

# monitor = record what would be moved, move nothing (start here). enforce = move to Spam.
MODE=monitor

# Budget alert, in your billing account's currency: Google emails the billing admins at the first
# charge to this project (a pilot should cost nothing). Empty = 1. off = no alert.
BUDGET_ALERT=1

# Optional (leave empty for the defaults in docs/DEPLOY.md).
AI_MOVE_THRESHOLD=
AI_SUSPICIOUS_THRESHOLD=
ALLOW_DOMAINS=
ALLOW_ADDRESSES=
BRAKE_PER_HOUR=
CAMPAIGN_HOLD_AFTER=

# The most worker instances at once (1 to 100). Empty = 30: a campaign to 10,000 mailboxes is checked in
# minutes. They cost only while they work.
WORKER_MAX_INSTANCES=

# How long each email's record is kept, in days (14 to 365); each is deleted on its own date, the oldest
# first. Also changeable on the dashboard (Settings → Policy). Empty = 35.
RETENTION_DAYS=

# Where alerts are emailed: the brake, moving a campaign paused for your decision, Gmail gone quiet, a failed job.
# Empty = ADMIN_GROUP (the group must accept mail from outside: alerts come from Google Cloud).
# off = no emails; alerts still show in the dashboard. Google charges for the two alert policies this makes:
# about $0.70 a month at its published price ($0.35 a month each).
ALERT_EMAIL=

# How long Status → Activity (what admins did, alerts, errors) is kept, in days (30 to 1825). It holds no
# email text: mailbox addresses, sender domains and admins' names. Empty = 365.
AUDIT_DAYS=

# OPTIONAL, OFF BY DEFAULT: GOOGLE CLOUD CHARGES FOR THESE (a little).
# on = an email when Gmail's notifications have waited in Pub/Sub over 30 minutes (the worker isn't taking
# them, so new mail isn't checked). A metric-based alert policy: about $0.40 a month. Needs ALERT_EMAIL.
PUBSUB_BACKLOG_ALERT=
# on = a copy of Status → Activity in Cloud Logging, in its own log bucket (spruce-audit), where a Firestore
# wipe can't reach it, kept AUDIT_LOG_DAYS (30 to 3650; empty = 365). Google charges for keeping logs past
# 30 days ($0.01 per GiB a month): a few cents a year here. Turning it off stops the copies; the bucket
# keeps what it has until its retention ends.
AUDIT_LOG=
AUDIT_LOG_DAYS=

# Your time zone, as an IANA name (for example America/New_York): the daily jobs run at night there, and
# the weekly summary (if turned on in the dashboard) arrives Monday from 7 AM. Empty = UTC.
TIME_ZONE=
